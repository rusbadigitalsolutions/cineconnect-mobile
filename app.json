{
  "expo": {
    "name": "CineConnect",
    "slug": "cineconnect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.icon/Assets/icon.png",
    "scheme": "cineconnect",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cineconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.cineconnect.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/AppIcon.icon/Assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/AppIcon.icon/Assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload media to your CineConnect portfolio and posts.",
          "cameraPermission": "The app needs access to your camera to record monologues and take profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/AppIcon.icon/Assets/icon.png",
          "color": "#F59E0B"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73e4b468-2768-4164-b058-3803f14849f2"
      },
      "googleClientId": {
        "ios": "611492344945-06se1t4o41vlvqpfgtjp6dovge86ujv2.apps.googleusercontent.com",
        "android": "611492344945-eqqju3go8bfkl5rpo3pth3nr9ubluuhf.apps.googleusercontent.com",
        "web": "611492344945-0e6od0326gicnnkdu3h6pduomsna10fa.apps.googleusercontent.com"
      }
    },
    "owner": "rusdigits-team"
  }
}
